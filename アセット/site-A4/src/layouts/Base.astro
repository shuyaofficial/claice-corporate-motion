---
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/sub.css';
import '../styles/figures.css';
import '../styles/forms.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { relPath } from '../lib/urls';
import { absUrl, ldScript } from '../lib/seo';
import { loadShared } from '../lib/content';

interface Props {
  from: string;            // 出力ファイル（dist 内パス）
  title: string;
  description: string;
  canonical?: string;      // 絶対 URL
  ld?: unknown[];          // JSON-LD
  bodyClass?: string;
  scripts?: string[];      // 追加スクリプト（dist 内パス。例: form.js）
  noindex?: boolean;
}
const { from, title, description, canonical, ld = [], bodyClass = '', scripts = [], } = Astro.props;
const shared = loadShared();
const rel = (p: string) => relPath(from, p);
const ogImage = absUrl('web/og.jpg');
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex, nofollow">
<meta http-equiv="Content-Security-Policy" content="form-action 'none'">
<meta name="theme-color" content={shared.head.theme_color}>
{canonical && <link rel="canonical" href={canonical}>}
<meta property="og:type" content={from === 'index.html' ? 'website' : 'article'}>
<meta property="og:site_name" content="株式会社クレイス">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{canonical && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={ogImage}>
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<link rel="apple-touch-icon" sizes="180x180" href={rel('favicon/apple-touch-icon.png')}>
<link rel="icon" type="image/png" sizes="32x32" href={rel('favicon/favicon-32x32.png')}>
<link rel="icon" type="image/png" sizes="16x16" href={rel('favicon/favicon-16x16.png')}>
<link rel="mask-icon" href={rel('favicon/safari-pinned-tab.svg')} color="#0973c1">
<!-- GTM-N7ZQ8B6X は本番反映時に戻す -->
<script is:inline src={rel('motion.js')}></script>
{ld.map((o) => <script type="application/ld+json" is:inline set:html={ldScript(o)}></script>)}
</head>
<body class={bodyClass || undefined}>
<div id="contents">
<a class="skip" href="#main">本文へ移動</a>
<Header from={from} />
<slot />
<Footer from={from} />
</div>
<script is:inline src={rel('site.js')}></script>
{scripts.map((s) => <script is:inline src={rel(s)}></script>)}
</body>
</html>
